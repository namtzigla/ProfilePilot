#!/usr/bin/env python3
"""ProfilePilot for Linux: pick a browser/profile for every link you open.

Registers as the default browser (see install.sh) and shows a picker for
each URL, then hands the URL to the chosen browser/profile. Shares its config
format with the macOS app: ~/.config/profilepilot/config.json

The picker draws itself with whichever toolkit the machine has — GTK 3, GTK 4
or Qt (PyQt6/PySide6/PyQt5) — so there is nothing to install on most desktops.
With none of them, links still open in the top target, just without a picker.

Usage: profilepilot [browser flags] [url ...]
  with no url, opens a new window in the chosen browser; flags such as
  --incognito are forwarded to it unchanged.
  --list       print the resolved picker entries and exit
  --register   register as the default browser and exit
  --toolkit T  force a UI toolkit: gtk3, gtk4 or qt (also $PROFILEPILOT_TOOLKIT,
               which accepts a comma-separated preference order)
  --generate-config [--force]
               scan for installed browsers and profiles and write them to
               the config file (--force overwrites an existing one)

Config entry keys (all optional except "app"):
  app         executable name ("google-chrome-stable", "firefox") or full path
  name        display name in the picker
  profiles    enumerate profiles (default: true for known Chromium/Firefox)
  localState  override path to a Chromium "Local State" file
  profilesIni override path to a Firefox "profiles.ini" file
  args        extra command-line arguments
  enabled     false hides the browser without deleting the entry
  default     true marks the default browser (sorts first, Enter opens it)
"""

import configparser
import importlib
import importlib.util
import json
import os
import shutil
import sqlite3
import subprocess
import sys

