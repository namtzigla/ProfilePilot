SHORT_NAMES = {
    "google-chrome": "Chrome",
    "google-chrome-stable": "Chrome",
    "google-chrome-beta": "Chrome Beta",
    "chromium": "Chromium",
    "chromium-browser": "Chromium",
    "brave": "Brave",
    "brave-browser": "Brave",
    "microsoft-edge": "Edge",
    "microsoft-edge-stable": "Edge",
    "vivaldi-stable": "Vivaldi",
    "firefox": "Firefox",
    "zen-browser": "Zen",
}

KNOWN_EXECUTABLES = [
    "google-chrome-stable", "google-chrome", "chromium", "chromium-browser",
    "brave", "brave-browser", "microsoft-edge-stable", "vivaldi-stable",
    "firefox", "firefox-developer-edition", "librewolf", "waterfox",
    "zen-browser", "epiphany", "falkon", "qutebrowser", "opera",
]

DEFAULT_CONFIG = {"browsers": [{"name": "Chrome", "app": "google-chrome-stable"},
                               {"app": "firefox"}]}


def config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "profilepilot", "config.json")


def last_choice_path():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "profilepilot", "last-choice")


def detected_entries():
    """Config entries for every known browser installed, [] if none are."""
    entries, seen = [], set()
    for exe in KNOWN_EXECUTABLES:
        path = shutil.which(exe)
        if not path:
            continue
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        entry = {"app": exe}
        if exe in SHORT_NAMES:
            entry["name"] = SHORT_NAMES[exe]
        entries.append(entry)
    return entries


def starter_entries():
    return detected_entries() or DEFAULT_CONFIG["browsers"]


def load_config():
    """Returns (config, error). No config file -> auto-detected browsers."""
    try:
        with open(config_path()) as f:
            return json.load(f), None
    except FileNotFoundError:
        return {"browsers": starter_entries()}, None
    except Exception as exc:  # malformed JSON etc.
        return {"browsers": starter_entries()}, str(exc)


def resolve_app(app):
    if app.startswith(("/", "~")):
        path = os.path.expanduser(app)
        return path if os.access(path, os.X_OK) else None
    return shutil.which(app)


def base_name(app):
    return os.path.basename(app)


def load_chromium_profiles(local_state):
    """[(directory, name)] with the last-used profile first."""
    try:
        with open(local_state) as f:
            data = json.load(f)
        cache = data["profile"]["info_cache"]
    except Exception:
        return []
    last_used = data.get("profile", {}).get("last_used", "")
    profiles = [(directory, meta.get("name", directory)) for directory, meta in cache.items()]
    profiles.sort(key=lambda p: (p[0] != last_used, p[1].lower()))
    return profiles


def load_firefox_profiles(profiles_ini):
    """[(name, launch_args)]. Classic profiles use -P <name>; the newer
    profile manager (StoreID= in profiles.ini) keeps user-visible names in
    Profile Groups/<storeid>.sqlite and uses --profile <path>."""
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    if not parser.read(profiles_ini):
        return []
    base_dir = os.path.dirname(profiles_ini)
    ini_profiles, store_ids, install_default = [], [], None
    for section in parser.sections():
        values = parser[section]
        if section.startswith("Install"):
            install_default = values.get("Default", install_default)
        elif section.startswith("Profile"):
            if "Name" in values:
                ini_profiles.append((values["Name"], values.get("Path", ""),
                                     values.get("Default") == "1"))
            store_id = values.get("StoreID")
            if store_id and store_id not in store_ids:
                store_ids.append(store_id)

    for store_id in store_ids:
        db_path = os.path.join(base_dir, "Profile Groups", f"{store_id}.sqlite")
        stored = load_firefox_profile_group(db_path, base_dir, install_default)
        if stored:
            return stored

    ini_profiles.sort(key=lambda p: (not (p[1] == install_default or p[2]), p[0].lower()))
    return [(name, ["-P", name]) for name, _path, _default in ini_profiles]


def load_firefox_profile_group(db_path, base_dir, default_path):
    try:
        connection = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        rows = connection.execute("SELECT name, path FROM Profiles ORDER BY id").fetchall()
        connection.close()
    except sqlite3.Error:
        return []
    rows = [(name, path) for name, path in rows if name]
    rows.sort(key=lambda r: r[1] != default_path)
    return [(name, ["--profile", path if path.startswith("/") else os.path.join(base_dir, path)])
            for name, path in rows]


def targets_for(entry):
    """A list of {title, exe, args} for one config entry."""
    exe = resolve_app(entry["app"])
    if not exe:
        return []
    base = base_name(entry["app"])
    display = entry.get("name") or SHORT_NAMES.get(base, base)
    extra = entry.get("args", [])
    home = os.path.expanduser("~")
    state_path = entry.get("localState")
    if state_path:
        state_path = os.path.expanduser(state_path)
    elif base in CHROMIUM_CONFIG_DIRS:
        state_path = os.path.join(home, ".config", CHROMIUM_CONFIG_DIRS[base], "Local State")
    ini_path = entry.get("profilesIni")
    if ini_path:
        ini_path = os.path.expanduser(ini_path)
    elif base in FIREFOX_INI_DIRS:
        ini_path = os.path.join(home, FIREFOX_INI_DIRS[base], "profiles.ini")
    want_profiles = entry.get("profiles", state_path is not None or ini_path is not None)

    if want_profiles and state_path:
        profiles = load_chromium_profiles(state_path)
        if len(profiles) > 1:
            return [{"title": f"{display} — {name}", "exe": exe,
                     "args": [f"--profile-directory={directory}"] + extra}
                    for directory, name in profiles]
    if want_profiles and ini_path:
        profiles = load_firefox_profiles(ini_path)
        if len(profiles) > 1:
            return [{"title": f"{display} — {name}", "exe": exe, "args": launch + extra}
                    for name, launch in profiles]
    return [{"title": display, "exe": exe, "args": extra}]


def build_targets(config):
    default_group, rest = [], []
    for entry in config.get("browsers", []):
        if entry.get("enabled") is False:
            continue
        group = targets_for(entry)
        if entry.get("default") is True and not default_group:
            default_group = group
        else:
            rest.extend(group)
    return default_group + rest


def has_default_browser(config):
    return any(entry.get("default") is True and entry.get("enabled") is not False
               and resolve_app(entry["app"])
               for entry in config.get("browsers", []))


def promote_last_choice(targets):
    try:
        with open(last_choice_path()) as f:
            last = f.read().strip()
    except OSError:
        return targets
    for index, target in enumerate(targets):
        if target["title"] == last and index > 0:
            return [target] + targets[:index] + targets[index + 1:]
    return targets


def save_last_choice(title):
    path = last_choice_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(title)


def open_target(target, url, flags=()):
    command = [target["exe"]] + target["args"] + list(flags)
    if url:
        command.append(url)
    subprocess.Popen(command,
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def copy_to_clipboard(text):
    """External helpers first: they own the selection after we exit, which the
    in-process clipboards can only promise on GTK 3."""
    for command in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-ib"]):
        if shutil.which(command[0]):
            subprocess.run(command, input=text.encode(), check=False)
            return
    toolkit = load_toolkit()
    if toolkit:
        toolkit.copy_text(text)


# --- UI toolkits ------------------------------------------------------------
#
# The picker is drawn by whichever toolkit is installed. Each class below
# implements the same three calls and imports its toolkit in __init__, so
# nothing is loaded until a window is actually needed:
#   pick(url, targets) -> int index | "copy" | None
#   error(message, detail)
#   copy_text(text)

TOOLKIT_HINT = ("Install PyGObject with GTK (Arch: python-gobject gtk4, "
                "Debian/Ubuntu: python3-gi gir1.2-gtk-4.0, Fedora: python3-gobject gtk4) "
                "or Qt for Python (Arch: python-pyqt6, Debian/Ubuntu: python3-pyqt6, "
                "or: pip install PySide6).")

QT_BINDINGS = ("PyQt6", "PySide6", "PyQt5")


class Choice:
    """Mutable picker result shared with the toolkit's callbacks."""

    def __init__(self):
        self.value = None  # int index, "copy", or None


def gi_versions(namespace):
    """Versions of a GIR namespace that are installed, without importing it —
    Gtk 3.0 and 4.0 cannot both be required in one process."""
    try:
        import gi
    except ImportError:
        return []
    repository = getattr(gi, "Repository", None)
    if repository is None:  # PyGObject < 3.52
        try:
            gi.require_version("GIRepository", "2.0")
            from gi.repository import GIRepository
            repository = GIRepository.Repository
        except Exception:
            return []
    try:
        return list(repository.get_default().enumerate_versions(namespace))
    except Exception:
        return []


def middle_ellipsize(text, limit=48):
    if len(text) <= limit:
        return text
    head = (limit - 1) // 2
    return text[:head] + "…" + text[head + 1 - limit:]


class Gtk3Toolkit:
    name = "gtk3"

    @staticmethod
    def available():
        return "3.0" in gi_versions("Gtk")

    def __init__(self):
        import gi
        gi.require_version("Gtk", "3.0")
        # Pin Gdk too: on systems with GTK 4 installed alongside GTK 3,
        # importing Gdk unversioned resolves to 4.0 and then conflicts with
        # Gtk 3.0's own Gdk 3.0.
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, Gtk, Pango
        self.Gdk, self.Gtk, self.Pango = Gdk, Gtk, Pango

    def pick(self, url, targets):
        Gdk, Gtk, Pango = self.Gdk, self.Gtk, self.Pango
        choice = Choice()

        def finish(value):
            choice.value = value
            Gtk.main_quit()

        def on_key(_widget, event):
            if event.keyval == Gdk.KEY_Escape:
                Gtk.main_quit()
                return True
            index = event.keyval - Gdk.KEY_1
            if 0 <= index < min(len(targets), 9):
                finish(index)
                return True
            return False

        window = Gtk.Window(title="ProfilePilot")
        window.set_resizable(False)
        window.set_position(Gtk.WindowPosition.CENTER)
        window.set_keep_above(True)
        window.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        window.connect("delete-event", lambda *_: Gtk.main_quit())
        window.connect("key-press-event", on_key)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_property("margin", 16)

        title = Gtk.Label(xalign=0)
        title.set_markup("<b>Open link with</b>" if url else "<b>Open browser</b>")
        box.pack_start(title, False, False, 0)

        if url:
            url_label = Gtk.Label(label=url, xalign=0)
            url_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            url_label.set_max_width_chars(48)
            url_label.get_style_context().add_class("dim-label")
            box.pack_start(url_label, False, False, 6)

        for index, target in enumerate(targets):
            button = Gtk.Button(label=target["title"])
            button.get_child().set_xalign(0)
            button.connect("clicked", lambda _b, i=index: finish(i))
            box.pack_start(button, False, False, 0)
            if index == 0:
                button.grab_focus()

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cancel_button = Gtk.Button(label="Cancel")
        cancel_button.connect("clicked", lambda *_: Gtk.main_quit())
        if url:
            copy_button = Gtk.Button(label="Copy Link")
            copy_button.connect("clicked", lambda *_: finish("copy"))
            bottom.pack_start(copy_button, False, False, 0)
        bottom.pack_end(cancel_button, False, False, 0)
        box.pack_start(bottom, False, False, 8)

        window.add(box)
        window.show_all()
        Gtk.main()
        window.destroy()
        return choice.value

    def error(self, message, detail):
        Gtk = self.Gtk
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK, text=message)
        dialog.format_secondary_text(detail)
        dialog.run()
        dialog.destroy()

    def copy_text(self, text):
        clipboard = self.Gtk.Clipboard.get(self.Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(text, -1)
        clipboard.store()


class Gtk4Toolkit:
    name = "gtk4"

    @staticmethod
    def available():
        return "4.0" in gi_versions("Gtk")

    def __init__(self):
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Gdk", "4.0")
        from gi.repository import Gdk, GLib, Gtk, Pango
        self.Gdk, self.GLib, self.Gtk, self.Pango = Gdk, GLib, Gtk, Pango

    def pick(self, url, targets):
        Gdk, Gtk, Pango = self.Gdk, self.Gtk, self.Pango
        choice = Choice()
        loop = self.GLib.MainLoop()  # GTK 4 has no Gtk.main()

        def finish(value):
            choice.value = value
            loop.quit()

        def on_key(_controller, keyval, _keycode, _state):
            if keyval == Gdk.KEY_Escape:
                loop.quit()
                return True
            index = keyval - Gdk.KEY_1
            if 0 <= index < min(len(targets), 9):
                finish(index)
                return True
            return False

        window = Gtk.Window(title="ProfilePilot")
        window.set_resizable(False)
        window.connect("close-request", lambda *_: (loop.quit(), False)[1])
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", on_key)
        window.add_controller(keys)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for margin in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{margin}")(16)

        title = Gtk.Label(xalign=0)
        title.set_markup("<b>Open link with</b>" if url else "<b>Open browser</b>")
        box.append(title)

        if url:
            url_label = Gtk.Label(label=url, xalign=0)
            url_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            url_label.set_max_width_chars(48)
            url_label.set_margin_bottom(6)
            url_label.add_css_class("dim-label")
            box.append(url_label)

        first_button = None
        for index, target in enumerate(targets):
            button = Gtk.Button(label=target["title"])
            button.get_child().set_xalign(0)
            button.connect("clicked", lambda _b, i=index: finish(i))
            box.append(button)
            first_button = first_button or button

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom.set_margin_top(8)
        if url:
            copy_button = Gtk.Button(label="Copy Link")
            copy_button.connect("clicked", lambda *_: finish("copy"))
            bottom.append(copy_button)
        cancel_button = Gtk.Button(label="Cancel")
        cancel_button.connect("clicked", lambda *_: loop.quit())
        cancel_button.set_hexpand(True)
        cancel_button.set_halign(Gtk.Align.END)
        bottom.append(cancel_button)
        box.append(bottom)

        window.set_child(box)
        window.present()
        if first_button:
            first_button.grab_focus()
        loop.run()
        window.destroy()
        return choice.value

    def error(self, message, detail):
        Gtk = self.Gtk
        loop = self.GLib.MainLoop()
        if hasattr(Gtk, "AlertDialog"):  # GTK 4.10+
            dialog = Gtk.AlertDialog(message=message, detail=detail, modal=False)
            dialog.choose(None, None, lambda *_: loop.quit())
        else:
            dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING,
                                       buttons=Gtk.ButtonsType.OK, text=message,
                                       secondary_text=detail)
            dialog.connect("response", lambda *_: loop.quit())
            dialog.present()
        loop.run()

    def copy_text(self, text):
        # No clipboard manager handoff in GTK 4: this only holds while we run,
        # so it is a last resort behind wl-copy/xclip/xsel.
        display = self.Gdk.Display.get_default()
        if display:
            display.get_clipboard().set(text)


class QtToolkit:
    name = "qt"

    @staticmethod
    def available():
        return any(importlib.util.find_spec(binding) for binding in QT_BINDINGS)

    def __init__(self):
        for binding in QT_BINDINGS:
            try:
                self.core = importlib.import_module(f"{binding}.QtCore")
                self.widgets = importlib.import_module(f"{binding}.QtWidgets")
            except ImportError:
                continue
            self.binding = binding
            break
        else:
            raise ImportError("no Qt binding (%s)" % "/".join(QT_BINDINGS))
        self.name = f"qt ({self.binding})"
        # Keep the QApplication alive for the process: Qt requires exactly one
        # and destroying it invalidates every widget created under it.
        self.app = (self.widgets.QApplication.instance()
                    or self.widgets.QApplication(sys.argv[:1]))

    @staticmethod
    def key_code(key):
        """PyQt6 hands out enum members, PyQt5/PySide plain ints."""
        return int(getattr(key, "value", key))

    def pick(self, url, targets):
        Qt, widgets = self.core.Qt, self.widgets
        choice = Choice()
        escape, one = self.key_code(Qt.Key.Key_Escape), self.key_code(Qt.Key.Key_1)

        class PickerDialog(widgets.QDialog):
            def keyPressEvent(self, event):  # noqa: N802 (Qt naming)
                key = QtToolkit.key_code(event.key())
                if key == escape:
                    self.reject()
                    return
                index = key - one
                if 0 <= index < min(len(targets), 9):
                    choice.value = index
                    self.accept()
                    return
                super().keyPressEvent(event)

        dialog = PickerDialog()
        dialog.setWindowTitle("ProfilePilot")

        def finish(value):
            choice.value = value
            dialog.accept()

        layout = widgets.QVBoxLayout(dialog)
        layout.setContentsMargins(16, 16, 16, 16)
        layout.setSpacing(6)
        layout.addWidget(widgets.QLabel(
            "<b>Open link with</b>" if url else "<b>Open browser</b>"))

        if url:
            url_label = widgets.QLabel(middle_ellipsize(url))
            url_label.setToolTip(url)
            url_label.setEnabled(False)  # renders in the theme's dim colour
            layout.addWidget(url_label)

        first_button = None
        for index, target in enumerate(targets):
            button = widgets.QPushButton(target["title"])
            button.setStyleSheet("text-align: left; padding: 5px 10px;")
            button.clicked.connect(lambda *_, i=index: finish(i))
            layout.addWidget(button)
            first_button = first_button or button

        bottom = widgets.QHBoxLayout()
        if url:
            copy_button = widgets.QPushButton("Copy Link")
            copy_button.clicked.connect(lambda *_: finish("copy"))
            bottom.addWidget(copy_button)
        bottom.addStretch(1)
        cancel_button = widgets.QPushButton("Cancel")
        cancel_button.clicked.connect(lambda *_: dialog.reject())
        bottom.addWidget(cancel_button)
        layout.addSpacing(8)
        layout.addLayout(bottom)

        dialog.show()
        dialog.raise_()
        dialog.activateWindow()
        if first_button:
            first_button.setFocus()
        run = getattr(dialog, "exec", None) or dialog.exec_  # exec_ on PyQt5
        run()
        return choice.value

    def error(self, message, detail):
        # The static helper takes plain strings, so no enum juggling.
        self.widgets.QMessageBox.warning(None, message, detail)

    def copy_text(self, text):
        # Like GTK 4, ownership ends with the process on X11; wl-copy/xclip
        # are tried first for that reason.
        self.app.clipboard().setText(text)
        self.app.processEvents()


TOOLKITS = (Gtk3Toolkit, Gtk4Toolkit, QtToolkit)
QT_DESKTOPS = ("kde", "lxqt", "razor", "deepin", "trinity")


_FORCED_ORDER = []  # set by --toolkit
_TOOLKIT = ...  # loaded lazily; None once loading has failed


def parse_order(value):
    return [name.strip().lower() for name in value.split(",") if name.strip()]


def toolkit_order():
    """Preferred toolkit names, most wanted first. GTK 3 leads on GTK desktops
    because it is the only one that can center the picker and keep it above
    other windows on X11; Qt desktops get their own toolkit first so the
    picker inherits the session theme."""
    if _FORCED_ORDER:
        return _FORCED_ORDER
    forced = os.environ.get("PROFILEPILOT_TOOLKIT", "").strip()
    if forced:
        return parse_order(forced)
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    if any(name in desktop for name in QT_DESKTOPS):
        return ["qt", "gtk3", "gtk4"]
    return ["gtk3", "gtk4", "qt"]


def load_toolkit():
    """The first usable toolkit, or None (with a note on stderr) if the
    machine has neither PyGObject nor a Qt binding. Cached: a run shows at
    most one toolkit, and Qt in particular dislikes being set up twice."""
    global _TOOLKIT
    if _TOOLKIT is not ...:
        return _TOOLKIT
    by_name = {toolkit.name: toolkit for toolkit in TOOLKITS}
    problems = []
    for name in toolkit_order():
        toolkit = by_name.get(name)
        if toolkit is None:
            problems.append(f"unknown toolkit {name!r}, expected one of "
                            f"{', '.join(by_name)}")
        elif toolkit.available():
            try:
                _TOOLKIT = toolkit()
                return _TOOLKIT
            except Exception as exc:  # installed but unusable (broken typelib…)
                problems.append(f"{name}: {exc}")
    for problem in problems:
        print(f"profilepilot: {problem}", file=sys.stderr)
    print(f"profilepilot: no usable UI toolkit found. {TOOLKIT_HINT}", file=sys.stderr)
    _TOOLKIT = None
    return None


def error_dialog(message, detail):
    toolkit = load_toolkit()
    if toolkit:
        toolkit.error(message, detail)
    else:
        print(f"profilepilot: {message}: {detail}", file=sys.stderr)


def route(url, targets, flags=()):
    if len(targets) == 1:
        open_target(targets[0], url, flags)
        return
    toolkit = load_toolkit()
    if not toolkit:
        # No picker is possible, but dropping the link is worse than opening
        # the top target — the default browser, or the last one chosen.
        open_target(targets[0], url, flags)
        return
    choice = toolkit.pick(url, targets)
    if choice == "copy":
        copy_to_clipboard(url)
    elif isinstance(choice, int):
        save_last_choice(targets[choice]["title"])
        open_target(targets[choice], url, flags)


def generate_config(force=False):
    """Write a config listing every installed browser, then report what the
    picker will show for it — including the profiles found for each."""
    path = config_path()
    if os.path.exists(path) and not force:
        print(f"{path} already exists — pass --force to overwrite it.")
        return 1
    entries = detected_entries()
    if not entries:
        print("No known browsers found; nothing written.", file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump({"browsers": entries}, f, indent=2)
        f.write("\n")

    print(f"wrote {path}")
    for entry in entries:
        print(f"  {entry.get('name', entry['app'])} ({entry['app']})")
        for target in targets_for(entry):
            print(f"    - {target['title']}")
    print('\nProfiles are re-read at every launch, so ones you add later show up\n'
          'on their own. Edit the file to reorder or rename entries, mark one\n'
          '"default": true, or hide one with "enabled": false.')
    return 0


def take_toolkit_flag(args):
    """Strip --toolkit NAME / --toolkit=NAME so it is never forwarded to a
    browser, and make it the preferred order."""
    global _FORCED_ORDER
    rest = []
    pending = False
    for arg in args:
        if pending:
            _FORCED_ORDER = parse_order(arg)
            pending = False
        elif arg == "--toolkit":
            pending = True
        elif arg.startswith("--toolkit="):
            _FORCED_ORDER = parse_order(arg.split("=", 1)[1])
        else:
            rest.append(arg)
    if pending:
        print("profilepilot: --toolkit needs a name (gtk3, gtk4 or qt)", file=sys.stderr)
    return rest


def main():
    args = take_toolkit_flag(a for a in sys.argv[1:] if a)
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if args and args[0] == "--register":
        subprocess.run(["xdg-settings", "set", "default-web-browser", "profilepilot.desktop"],
                       check=False)
        return 0
    if args and args[0] == "--generate-config":
        return generate_config(force="--force" in args)
    if args and args[0] == "--list":
        config, _ = load_config()
        print(f"config: {config_path()}")
        for target in build_targets(config):
            print(f"  {target['title']}: {target['exe']} {' '.join(target['args'])}")
        installed = [toolkit.name for toolkit in TOOLKITS if toolkit.available()]
        toolkit = load_toolkit()
        print(f"toolkit: {toolkit.name if toolkit else 'none'} "
              f"(installed: {', '.join(installed) or 'none'}; "
              f"preference: {', '.join(toolkit_order())})")
        return 0

    # Anything starting with "-" is a browser flag (--incognito, --private-window)
    # to forward, not a URL. Desktop launchers invoke the default browser this
    # way — with flags only, or with no arguments at all to open a new window.
    flags = [a for a in args if a.startswith("-")]
    urls = [a for a in args if not a.startswith("-")]

    config, error = load_config()
    if error:
        error_dialog("ProfilePilot config error",
                     f"{config_path()}\n\n{error}\n\nUsing auto-detected browsers.")
    targets = build_targets(config)
    if not targets:
        error_dialog("No browsers found",
                     f"None of the browsers in {config_path()} are installed.")
        return 1
    if not has_default_browser(config):
        targets = promote_last_choice(targets)
    for url in urls or [None]:
        route(url, targets, flags)
    return 0


if __name__ == "__main__":
    sys.exit(main())
